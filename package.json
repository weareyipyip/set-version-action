{
    "name": "set-version-action",
    "version": "3.0.1",
    "description": "This action sets the version based on either the current commit hash or tag.",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "lint": "biome check .",
        "format": "biome format --write ./src",
        "typecheck": "tsc --noEmit",
        "prepare": "node build.mjs",
        "test": "node --test --experimental-test-module-mocks --disable-warning=ExperimentalWarning --disable-warning=DeprecationWarning \"src/**/*.test.ts\"",
        "all": "npm run lint && npm run typecheck && npm run prepare && npm run test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/weareyipyip/set-version-action.git"
    },
    "keywords": [],
    "author": "YipYip",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/weareyipyip/set-version-action/issues"
    },
    "homepage": "https://github.com/weareyipyip/set-version-action#readme",
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/github": "^9.1.1",
        "semver": "^7.8.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@types/node": "^24.0.0",
        "@types/semver": "^7.7.1",
        "esbuild": "0.28.1",
        "esbuild-plugin-license": "^1.2.3",
        "typescript": "^6.0.3"
    }
}
